rules_version = '2';

// LifeOS Firestore security rules.
//
// Data model (see docs/ARCHITECTURE.md § Database):
//   users/{uid}/{collection}/{id}   user-owned synced records (client read/write)
//   users/{uid}/devices/{token}     FCM tokens (client write)
//   entitlements/{uid}              Premium status (server-only write, owner read)
//   usage/**, rate_limits/**, purchases/**, ai_cache/**, news_cache/**,
//   ssv_transactions/**, billing_events/**, metrics_daily/**  server-only
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Collections replicated by the app's sync engine (lib/data/collections.dart).
    function isSyncedCollection(c) {
      return c in ['profile', 'tasks', 'transactions', 'budgets', 'habits', 'habit_logs',
                   'mood_logs', 'sleep_logs', 'meal_plans', 'pantry_items', 'shopping_items',
                   'ai_memories', 'daily_scores', 'daily_goals', 'achievements', 'saved_items',
                   'savings_goals', 'recurring_bills', 'routines', 'life_goals', 'debts', 'medications',
                   'med_doses'];
    }

    // Every synced write carries sync metadata and a server timestamp used
    // for pull cursors; it cannot be forged from the client.
    function validSyncMeta(docId) {
      let d = request.resource.data;
      return d.id == docId
        && d.updatedAt is int
        && d.deleted is bool
        && d._serverTs == request.time
        && d.keys().size() <= 40
        && docId.size() <= 128;
    }

    // Light per-collection type checks (defence in depth; the app validates too).
    function validBody(c) {
      let d = request.resource.data;
      return d.deleted == true
        || (c == 'transactions' && d.amountMinor is int && d.amountMinor >= 0 && d.amountMinor <= 100000000000
            && d.type in ['expense', 'income'] && d.currency is string && d.currency.size() <= 5)
        || (c == 'tasks' && d.title is string && d.title.size() <= 200)
        || (c == 'mood_logs' && d.mood is int && d.mood >= 1 && d.mood <= 5)
        || (c == 'habit_logs' && d.count is int && d.count >= 0 && d.count <= 1000)
        || (c == 'ai_memories' && d.content is string && d.content.size() <= 300)
        || (c == 'saved_items' && d.title is string && d.title.size() <= 200 && d.kind is string && d.kind.size() <= 40)
        || (c == 'savings_goals' && d.name is string && d.name.size() <= 80
            && d.targetMinor is int && d.targetMinor >= 0 && d.targetMinor <= 100000000000
            && d.savedMinor is int && d.savedMinor >= 0 && d.savedMinor <= 100000000000)
        || (c == 'recurring_bills' && d.name is string && d.name.size() <= 80
            && d.amountMinor is int && d.amountMinor >= 0 && d.amountMinor <= 100000000000
            && d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 31)
        || (c == 'routines' && d.name is string && d.name.size() <= 80 && d.steps is list && d.steps.size() <= 30)
        || (c == 'life_goals' && d.title is string && d.title.size() <= 120 && d.steps is list && d.steps.size() <= 60)
        || (c == 'debts' && d.person is string && d.person.size() <= 80
            && d.amountMinor is int && d.amountMinor >= 0 && d.amountMinor <= 100000000000 && d.theyOwe is bool)
        || (c == 'medications' && d.name is string && d.name.size() <= 80 && d.times is list && d.times.size() <= 12)
        || !(c in ['transactions', 'tasks', 'mood_logs', 'habit_logs', 'ai_memories', 'saved_items',
                   'savings_goals', 'recurring_bills', 'routines', 'life_goals', 'debts', 'medications']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['platform', 'locale', 'timeZone', 'updatedAt'])
          && token.size() <= 512;
      }

      match /{collection}/{docId} {
        allow read: if isOwner(uid) && isSyncedCollection(collection);
        allow create, update: if isOwner(uid)
          && isSyncedCollection(collection)
          && validSyncMeta(docId)
          && validBody(collection);
        // Deletions sync as tombstones (update with deleted == true).
        allow delete: if false;
      }
    }

    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Everything else is server-only (Admin SDK bypasses these rules).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
