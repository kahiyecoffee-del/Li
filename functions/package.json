{
  "name": "lifeos-functions",
  "private": true,
  "description": "LifeOS backend: AI proxy, credits, rewards, billing verification, news, account deletion.",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "^183.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
